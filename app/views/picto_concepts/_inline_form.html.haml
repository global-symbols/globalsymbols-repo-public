= bootstrap_form_with url: symbolset_symbol_concepts_path(picto.symbolset, picto), layout: :horizontal, label_col: 'col', control_col: 'col-sm-12' do |f|
  .form-group.row.mb-0
    %label.sr-only{for: 'concept'}= t('views.picto_concepts.index.add_concept.button')
    .col-sm-12
      .input-group
        = f.text_field :concept, wrapper: false, skip_label: true, class: 'form-control', placeholder: t('views.picto_concepts.index.add_concept.button'), required: true
        .input-group-append
          = f.primary t('views.picto_concepts.index.add_concept.add')