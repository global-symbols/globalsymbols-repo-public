= bootstrap_form_for suggestion, url: translation_path(suggestion.picto.id), layout: :horizontal, label_col: 'col', control_col: 'col-sm-12', method: :patch, remote: true do |f|
  = f.hidden_field :label_id, value: suggestion.id
  .form-group.row.mb-0
    = f.label :text, t('views.translations._suggestion_form.label'), class: 'sr-only col-form-label col'
    .col-sm-12
      .input-group
        = f.text_field :text, wrapper: false, skip_label: true, class: 'form-control', required: true
        .input-group-append
          = f.primary t('views.translations._suggestion_form.button_publish'), data: { disable_with: t('views.translations._suggestion_form.button_publish_working') }