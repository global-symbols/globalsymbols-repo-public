# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development
/storage/*
/public/uploads/*
/public/public/uploads/**

/node_modules
/yarn-error.log

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore Windows/MacOS junk
[Tt]humbs.db
*.DS_Store

# Ignore master key for decrypting credentials and more.
/config/master.key

/config/credentials/production.key

/config/credentials/development.key

/config/credentials/test.key

# Ignore environment configuration files
/.env.rb

/.idea/remote-mappings.xml
/.idea/dataSources.xml

/vendor

# Local-only docs and upgrade notes (not committed)
/local_docs/
/local_rails_upgrade/

# Local-only Docker (deploy Dockerfile is committed for Kamal / pre-prod / prod)
Dockerfile.dev
docker-compose.yml

# Kamal secrets (examples are committed; real files are not)
.kamal/secrets
.kamal/secrets-common
.kamal/secrets.*
!.kamal/secrets.example
!.kamal/README.md
