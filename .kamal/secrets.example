# Copy to the matching secrets file and fill in real values.
#   cp .kamal/secrets.example .kamal/secrets-common
#   cp .kamal/secrets.example .kamal/secrets.pre-prod
#
# Kamal loads (dotenv):
#   .kamal/secrets-common
#   .kamal/secrets                 (optional)
#   .kamal/secrets.<destination>   e.g. secrets.pre-prod
#
# NEVER commit real secret files.

# --- Docker registry: GHCR (config/deploy.yml → ghcr.io/global-symbols/...) ---
# Username: your GitHub username
# Password: classic PAT with at least: write:packages, read:packages
#   (and read:org if the package is under the org)
# After first push, grant the org package access if needed:
#   github.com/orgs/global-symbols/packages
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxx

# --- Rails ---
# Generate: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=

# --- MySQL (pre-prod accessory + app) ---
# App uses GS_DATABASE_PASSWORD; accessory uses MYSQL_* (can be the same value).
GS_DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Shared Redis (172.31.13.8) — same password as live envs ---
REDIS_PASSWORD=

# --- Directus CMS ---
DIRECTUS_TOKEN_CMS=
DIRECTUS_WEBHOOK_SECRET=
