# Copy to the matching secrets file and fill in real values.
#   cp .kamal/secrets.example .kamal/secrets-common
#   cp .kamal/secrets.example .kamal/secrets.pre-prod
#
# Kamal loads (dotenv):
#   .kamal/secrets-common
#   .kamal/secrets                 (optional)
#   .kamal/secrets.<destination>   e.g. secrets.pre-prod
#
# NEVER commit real secret files.

# --- Docker registry: GHCR (config/deploy.yml → ghcr.io/global-symbols/...) ---
# Username: your GitHub username
# Password: classic PAT with at least: write:packages, read:packages
#   (and read:org if the package is under the org)
# After first push, grant the org package access if needed:
#   github.com/orgs/global-symbols/packages
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxx

# --- Rails ---
# Generate: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=

# --- MySQL (pre-prod + production accessory + app) ---
# App uses GS_DATABASE_PASSWORD; accessory uses MYSQL_* (can be the same value).
# Required in secrets.pre-prod and secrets.production before accessory boot.
GS_DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Prod replica prep on Go box (optional until cutover C2):
# MYSQL_REPL_PASSWORD=
# MYSQL8_REPLICA_ROOT_PASSWORD=

# --- Shared Redis (172.31.13.8) — same password as live envs ---
REDIS_PASSWORD=

# --- Directus CMS ---
DIRECTUS_TOKEN_CMS=
DIRECTUS_WEBHOOK_SECRET=

# --- Post-deploy suite (pre-prod only; menu → verify auth/CRUD) ---
# Dedicated Devise user in the pre-prod DB (not a real person).
# Create once on the server, e.g.:
#   docker exec $WEB bundle exec rails runner '
#     u = User.find_or_initialize_by(email: "deploy-verify@gs-test.co.uk")
#     u.password = u.password_confirmation = "…same as DEPLOY_VERIFY_USER_PASSWORD…"
#     u.prename = "Deploy"; u.surname = "Verify"
#     u.language = Language.order(:id).first
#     u.role = :user
#     u.save!
#   '
# Wire into config/deploy.pre-prod.yml env.secret (already listed).
# Do NOT set these on production.
DEPLOY_VERIFY_USER_EMAIL=deploy-verify@gs-test.co.uk
DEPLOY_VERIFY_USER_PASSWORD=

# --- AI image generator (pre-prod / production → green-colo Flux API) ---
# AZURE_API_BASE is set in config/deploy.pre-prod.yml and deploy.production.yml (clear).
# Key must match the API on that host (see .env.rb / docker-compose for local).
# Live production today still uses systemd Environment= on global-symbols-ec2;
# these Kamal entries apply once production is cut over to Kamal.
AZURE_API_KEY=

# --- Contentful (knowledge base + About CMS pages) ---
# From systemd Environment= on global-symbols-ec2-test / global-symbols-ec2.
# Listed under env.secret in deploy.pre-prod.yml and deploy.production.yml.
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_SPACE_ID=

# --- Amazon SES SMTP (Devise: password reset, confirmations, etc.) ---
# From systemd Environment= on global-symbols-ec2-test / global-symbols-ec2.
# Listed under env.secret in deploy.pre-prod.yml and deploy.production.yml.
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
