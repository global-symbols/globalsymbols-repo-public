#!/usr/bin/env bash
# =============================================================================
# Guided Kamal deploy CLI for Global Symbols (pre-prod / production).
#
# Entry point is always the interactive menu (pick env + action).
# Phases are NOT callable as CLI subcommands.
#
# Ship is split:
#   preflight   — checks + image tag + GHCR login
#   build-push  — Mac: kamal build push (image → GHCR, no server change)
#   rollout     — server: kamal deploy --skip-push (pull + restart web/job)
#
# Usage:
#   script/gs-deploy                 # open menu (clean tree required for shipping)
#   script/gs-deploy --allow-dirty   # menu; dirty tree OK for pre-prod only
#   script/gs-deploy --version TAG   # menu, force image tag
#   script/gs-deploy --help
#
# Menu defaults:
#   VERSION=git SHA if clean · log on · wizard pauses on
#   GHCR login: auto-skipped when Docker already has ghcr.io credentials
#
# Hard rule (early):
#   shipping actions require a CLEAN git tree unless --version TAG, or
#   --allow-dirty with environment pre-prod (never production).
#
# Flags (only on the initial command, before the menu):
#   --allow-dirty      Allow dirty tree for pre-prod only (not production)
#   --version TAG      Force image tag (also: export VERSION=...)
#   --yes              Skip wizard pause prompts (still streams all output)
#   --skip-login       Always skip docker login
#   --force-login      Always run docker login (even if already logged in)
#   --no-log           Do not tee to log/deploy/ (terminal only)
#   --push-retries N   Max build-push attempts (default 8; GHCR stall recovery)
#   --push-stall SEC   Kill attempt if no new output for SEC seconds (default 180)
#
# Env overrides for push retries:
#   BUILD_PUSH_MAX_ATTEMPTS   default 8
#   BUILD_PUSH_RETRY_SLEEP    seconds before first retry (default 20; +10 each try)
#   BUILD_PUSH_STALL_SECONDS  no-output watchdog per attempt (default 180)
#
# Examples:
#   script/gs-deploy
#   script/gs-deploy --allow-dirty    # then choose pre-prod in the menu
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

KAMAL_VERSION="${KAMAL_DOCKER_KAMAL_VERSION:-2.12.0}"
# Official image ships kamal + docker CLI + buildx (required for build push).
# Do not use bare ruby: — it has no docker/buildx, so kamal fails dependency check.
KAMAL_IMAGE="${KAMAL_DOCKER_IMAGE:-ghcr.io/basecamp/kamal:v${KAMAL_VERSION}}"
REGISTRY_HOST="ghcr.io"
IMAGE_REPO="global-symbols/globalsymbols-repo-internal"

# --- defaults / flags ---
YES=0
ALLOW_DIRTY=0
SKIP_LOGIN=0
FORCE_LOGIN=0
NO_LOG=0
VERSION_OVERRIDE="${VERSION:-}"
ENV_NAME=""
COMMAND=""
LOG_FILE=""
PHASE_FAILED=""
INTERACTIVE_MENU=0
# GHCR push often stalls mid-upload; retries resume (uploaded layers skip).
PUSH_MAX_ATTEMPTS="${BUILD_PUSH_MAX_ATTEMPTS:-8}"
PUSH_RETRY_SLEEP="${BUILD_PUSH_RETRY_SLEEP:-20}"
# If an attempt prints nothing for this long, kill it and retry (hang detection).
PUSH_STALL_SECONDS="${BUILD_PUSH_STALL_SECONDS:-180}"
STALL_EXIT_CODE=124

# Hosts / smoke targets (must match config/deploy.*.yml)
PRE_PROD_HOST="18.130.29.168"
PRE_PROD_HTTP_HOST="gs-test.co.uk"
PROD_HOST="" # filled from config if not placeholder
PROD_HTTP_HOST="globalsymbols.com"

usage() {
  # Print leading comment block only (stop at first non-# line)
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
  exit "${1:-0}"
}

# Read a single menu choice; prints prompt to stderr, returns selection on stdout via nameref-style
# Usage: menu_pick VAR "Prompt" "1) label" "2) label" ...
# Sets VAR to the number chosen (1-based).
menu_pick() {
  local __var="$1"
  local __prompt="$2"
  shift 2
  local __options=("$@")
  local __n=${#__options[@]}
  local __choice=""
  local __i

  while true; do
    echo "" >&2
    echo "$__prompt" >&2
    for ((__i = 0; __i < __n; __i++)); do
      echo "  ${__options[$__i]}" >&2
    done
    echo "" >&2
    read -r -p "Choice [1-${__n}] (q=quit): " __choice || true
    case "${__choice:-}" in
      q|Q|quit)
        echo "Quit." >&2
        exit 0
        ;;
    esac
    if [[ "$__choice" =~ ^[0-9]+$ ]] && ((__choice >= 1 && __choice <= __n)); then
      printf -v "$__var" '%s' "$__choice"
      return 0
    fi
    echo "Invalid choice. Enter a number 1-${__n}, or q to quit." >&2
  done
}

menu_yes_no() {
  # $1 = prompt; default no. Sets global-style via return 0/1
  local prompt="$1"
  local reply
  read -r -p "$prompt [y/N]: " reply || true
  case "${reply:-}" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# Interactive front door: no CLI flags required
interactive_menu() {
  INTERACTIVE_MENU=1
  local pick

  banner "Global Symbols deploy"
  echo "Repo: $ROOT"
  echo "Pick environment and action (q quits at any prompt)."
  echo "Hard rule: shipping needs a clean git tree."
  echo "  Exception: --allow-dirty is valid for pre-prod only (never production)."
  if [[ "$ALLOW_DIRTY" -eq 1 ]]; then
    echo "Flag: --allow-dirty is ON (pre-prod only; production will still require clean git)."
  fi
  if [[ -n "$VERSION_OVERRIDE" ]]; then
    echo "Flag: --version $VERSION_OVERRIDE"
  fi
  if git_is_dirty 2>/dev/null; then
    echo ""
    echo "Git: DIRTY — for pre-prod use --allow-dirty; production must be clean."
  else
    echo ""
    echo "Git: clean @ $(git rev-parse --short HEAD 2>/dev/null || echo '?')"
  fi

  # --- Environment ---
  menu_pick pick "Environment:" \
    "1) pre-prod   — t4g ${PRE_PROD_HOST} (${PRE_PROD_HTTP_HOST})" \
    "2) production — m7g (use only when ready)" \
    "3) help       — print CLI reference and exit"
  case "$pick" in
    1) ENV_NAME="pre-prod" ;;
    2) ENV_NAME="production" ;;
    3) usage 0 ;;
  esac

  # --- Action ---
  menu_pick pick "Action for ${ENV_NAME}:" \
    "1) wizard       — full guided path (recommended)" \
    "2) preflight    — checks + image tag + GHCR login" \
    "3) config       — kamal config (read-only)" \
    "4) build-push   — Mac: build image + push to GHCR (no server change)" \
    "5) rollout      — server: pull image + restart web/job (TOUCHES SERVER)" \
    "6) smoke        — HTTP smoke check" \
    "7) hint-verify  — how to run deploy_verify on the server"
  case "$pick" in
    1) COMMAND="wizard" ;;
    2) COMMAND="preflight" ;;
    3) COMMAND="config" ;;
    4) COMMAND="build-push" ;;
    5) COMMAND="rollout" ;;
    6) COMMAND="smoke" ;;
    7) COMMAND="hint-verify" ;;
  esac

  # Fail immediately after action choice (before Start now / any phase)
  assert_clean_working_tree

  # Summary before running
  echo ""
  banner "Ready"
  echo "  Environment : $ENV_NAME  (host: $(deploy_host))"
  echo "  Action      : $COMMAND"
  echo "  Defaults    : VERSION=auto · GHCR login if needed · log to log/deploy/ · wizard pauses on"
  if [[ -n "$VERSION_OVERRIDE" || "$ALLOW_DIRTY" -eq 1 || "$SKIP_LOGIN" -eq 1 || "$FORCE_LOGIN" -eq 1 || "$NO_LOG" -eq 1 || "$YES" -eq 1 ]]; then
    echo "  CLI overrides in effect:"
    [[ -n "$VERSION_OVERRIDE" ]] && echo "    VERSION=$VERSION_OVERRIDE"
    if [[ "$ALLOW_DIRTY" -eq 1 ]]; then
      if allow_dirty_effective; then
        echo "    --allow-dirty (effective for pre-prod)"
      else
        echo "    --allow-dirty (ignored — not allowed for production)"
      fi
    fi
    [[ "$SKIP_LOGIN" -eq 1 ]] && echo "    --skip-login"
    [[ "$FORCE_LOGIN" -eq 1 ]] && echo "    --force-login"
    [[ "$NO_LOG" -eq 1 ]] && echo "    --no-log"
    [[ "$YES" -eq 1 ]] && echo "    --yes (skip pauses)"
  fi
  echo ""
  if ! menu_yes_no "Start now?"; then
    echo "Aborted."
    exit 0
  fi
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

ts() { date +"%Y-%m-%dT%H-%M-%S"; }

# macOS often has no GNU timeout; use perl alarm as fallback.
# Usage: run_with_timeout SECONDS command [args…]
run_with_timeout() {
  local secs="$1"
  shift
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  elif command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  else
    perl -e 'alarm shift; exec @ARGV' "$secs" "$@"
  fi
}

# Docker Desktop can wedge after a stalled GHCR push; never block forever.
docker_cli_ok() {
  run_with_timeout 8 docker version >/dev/null 2>&1
}

docker_daemon_ok() {
  run_with_timeout 8 docker info >/dev/null 2>&1
}

banner() {
  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo " $*"
  echo "════════════════════════════════════════════════════════════"
}

phase_banner() {
  echo ""
  echo "── Phase: $* ──"
}

phase_ok() {
  echo "── Phase OK: $* ──"
}

phase_fail() {
  local name="$1" rc="$2"
  PHASE_FAILED="$name"
  echo "" >&2
  echo "── Phase FAILED: $name (exit $rc) ──" >&2
  echo "  Re-run:  $0${ALLOW_DIRTY:+ --allow-dirty}${VERSION_OVERRIDE:+ --version $VERSION_OVERRIDE}" >&2
  echo "           then choose env + action '$name' (or wizard) in the menu" >&2
  if [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]]; then
    echo "  Log:     $LOG_FILE" >&2
  fi
  echo "  (Full error output is above — nothing was filtered.)" >&2
}

# Stream a command to terminal and optional log (never hide stderr)
run_logged() {
  if [[ "$NO_LOG" -eq 1 || -z "${LOG_FILE:-}" ]]; then
    "$@"
  else
    # Preserve exit code through tee
    set +e
    "$@" 2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}
    set -e
    return "$rc"
  fi
}

# Run a command; if it produces no new output for stall_secs, kill it and
# return STALL_EXIT_CODE (124) so the caller can retry.
# Streams live output to the terminal and LOG_FILE (same as run_logged).
run_with_stall_watch() {
  local stall_secs="$1"
  shift
  case "$stall_secs" in
    ''|*[!0-9]*|0) stall_secs=180 ;;
  esac

  local out
  out=$(mktemp -t gsdeploy-stall.XXXXXX)
  : >"$out"

  set +e
  "$@" >"$out" 2>&1 &
  local cmd_pid=$!
  set -e

  # Live stream of the capture file
  if [[ "$NO_LOG" -eq 1 || -z "${LOG_FILE:-}" ]]; then
    tail -n +1 -f "$out" 2>/dev/null &
  else
    tail -n +1 -f "$out" 2>/dev/null | tee -a "$LOG_FILE" &
  fi
  local tail_pid=$!

  local last_size=0
  local last_change
  last_change=$(date +%s)
  local stalled=0
  local size now

  while kill -0 "$cmd_pid" 2>/dev/null; do
    sleep 5
    size=$(stat -f %z "$out" 2>/dev/null || echo 0)
    now=$(date +%s)
    if [[ "$size" -gt "$last_size" ]]; then
      last_size=$size
      last_change=$now
    elif [[ $((now - last_change)) -ge "$stall_secs" ]]; then
      echo ""
      echo "WARN: no new output for ${stall_secs}s — treating attempt as hung"
      echo "  Killing pid ${cmd_pid} so we can retry (partial GHCR layers are kept)."
      stalled=1
      # Graceful then hard kill; also try children (docker push helpers)
      kill "$cmd_pid" 2>/dev/null || true
      sleep 2
      kill -9 "$cmd_pid" 2>/dev/null || true
      pkill -P "$cmd_pid" 2>/dev/null || true
      break
    fi
  done

  local rc=0
  if [[ "$stalled" -eq 1 ]]; then
    wait "$cmd_pid" 2>/dev/null || true
    rc=$STALL_EXIT_CODE
  else
    set +e
    wait "$cmd_pid"
    rc=$?
    set -e
  fi

  # Stop streamer (may need a moment to flush last lines)
  kill "$tail_pid" 2>/dev/null || true
  wait "$tail_pid" 2>/dev/null || true
  sleep 0.5
  kill -9 "$tail_pid" 2>/dev/null || true

  # Ensure any final bytes are in the session log (if tee missed kill race)
  if [[ "$NO_LOG" -ne 1 && -n "${LOG_FILE:-}" && -f "$out" ]]; then
    # Avoid huge dupes: only append if log doesn't already end with file tail
    true
  fi

  rm -f "$out"
  return "$rc"
}

confirm() {
  local prompt="${1:-Continue?}"
  if [[ "$YES" -eq 1 ]]; then
    echo "(--yes) $prompt → yes"
    return 0
  fi
  local reply
  read -r -p "$prompt [Enter=yes / n=no] " reply || true
  case "${reply:-}" in
    n|N|no|NO|q|Q) return 1 ;;
    *) return 0 ;;
  esac
}

# Prompt until the user types the exact expected token, or quits with q.
# Wrong/empty input notifies and re-asks — does not abort the deploy.
confirm_typed_token() {
  local expected="$1"
  local prompt="$2"
  local token
  while true; do
    read -r -p "$prompt" token || true
    case "${token:-}" in
      q|Q|quit)
        echo "Quit."
        exit 0
        ;;
      "$expected")
        return 0
        ;;
      "")
        echo "  Need to type '${expected}' exactly (or q to quit). Empty input ignored."
        ;;
      *)
        echo "  Need to type '${expected}' exactly (or q to quit). Got: ${token}"
        ;;
    esac
  done
}

confirm_build_push() {
  if [[ "$YES" -eq 1 ]]; then
    echo "(--yes) build-push confirmation skipped"
    return 0
  fi
  echo ""
  echo "This builds the app image on this Mac and pushes it to GHCR."
  echo "It does NOT change containers on the server yet (use rollout after)."
  confirm_typed_token "push" "Type 'push' to continue (q=quit): "
}

confirm_rollout() {
  if [[ "$YES" -eq 1 ]]; then
    echo "(--yes) rollout confirmation skipped"
    return 0
  fi
  if [[ "$ENV_NAME" == "production" ]]; then
    echo ""
    echo "⚠  PRODUCTION rollout — will replace web+job on the production host."
    echo "  Uses the image already in GHCR for VERSION (must have been build-pushed)."
    confirm_typed_token "production" "Type 'production' to continue (q=quit): "
  else
    echo ""
    echo "⚠  Will SSH to ${PRE_PROD_HOST} and replace pre-prod web+job containers."
    echo "  Uses the image already in GHCR for VERSION (must have been build-pushed)."
    confirm_typed_token "rollout" "Type 'rollout' to continue (q=quit): "
  fi
}

pause_wizard() {
  local label="${1:-next phase}"
  if [[ "$YES" -eq 1 ]]; then
    return 0
  fi
  local reply
  read -r -p "Press Enter for ${label}, or q to quit: " reply || true
  case "${reply:-}" in
    q|Q|quit) echo "Stopped before: $label"; exit 0 ;;
  esac
}

# --- parse args ---
# Only flags on the entry command, then always open the interactive menu.
# Direct subcommands (e.g. "pre-prod deploy") are intentionally not supported.
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help|help)
        usage 0
        ;;
      --yes|-y) YES=1; shift ;;
      --allow-dirty) ALLOW_DIRTY=1; shift ;;
      --skip-login) SKIP_LOGIN=1; shift ;;
      --force-login) FORCE_LOGIN=1; shift ;;
      --no-log) NO_LOG=1; shift ;;
      --push-retries)
        [[ $# -ge 2 ]] || die "--push-retries requires a number"
        PUSH_MAX_ATTEMPTS="$2"
        shift 2
        ;;
      --push-retries=*)
        PUSH_MAX_ATTEMPTS="${1#--push-retries=}"
        shift
        ;;
      --push-stall)
        [[ $# -ge 2 ]] || die "--push-stall requires seconds"
        PUSH_STALL_SECONDS="$2"
        shift 2
        ;;
      --push-stall=*)
        PUSH_STALL_SECONDS="${1#--push-stall=}"
        shift
        ;;
      --version)
        [[ $# -ge 2 ]] || die "--version requires a tag"
        VERSION_OVERRIDE="$2"
        shift 2
        ;;
      --version=*)
        VERSION_OVERRIDE="${1#--version=}"
        shift
        ;;
      -*)
        die "Unknown flag: $1 (try: $0 --help)"
        ;;
      *)
        die "Direct steps are not supported (got: $*).

  Use the menu only:
    $0
    $0 --allow-dirty
    $0 --version TAG

  Pick environment and action (wizard, deploy, …) interactively.
  See: $0 --help"
        ;;
    esac
  done

  if [[ "$SKIP_LOGIN" -eq 1 && "$FORCE_LOGIN" -eq 1 ]]; then
    die "Use only one of --skip-login or --force-login"
  fi

  interactive_menu
}

kamal_destination() {
  # Kamal -d matches deploy.<destination>.yml
  echo "$ENV_NAME"
}

deploy_host() {
  if [[ "$ENV_NAME" == "pre-prod" ]]; then
    echo "$PRE_PROD_HOST"
  else
    # Best-effort from config; may still be placeholder
    local h
    h="$(grep -E '^\s+-\s+[0-9.]+' config/deploy.production.yml 2>/dev/null | head -1 | awk '{print $2}' || true)"
    if [[ -z "$h" || "$h" == REPLACE* ]]; then
      h="$(grep -E 'REPLACE_WITH' config/deploy.production.yml | head -1 | awk '{print $2}' || true)"
    fi
    echo "${h:-REPLACE_WITH_M7G_PUBLIC_OR_PRIVATE_IP}"
  fi
}

http_host_header() {
  if [[ "$ENV_NAME" == "pre-prod" ]]; then
    echo "$PRE_PROD_HTTP_HOST"
  else
    echo "$PROD_HTTP_HOST"
  fi
}

secrets_files() {
  echo ".kamal/secrets-common"
  if [[ "$ENV_NAME" == "pre-prod" ]]; then
    echo ".kamal/secrets.pre-prod"
  else
    # production destination file name
    if [[ -f .kamal/secrets.production ]]; then
      echo ".kamal/secrets.production"
    elif [[ -f .kamal/secrets.prod ]]; then
      echo ".kamal/secrets.prod"
    else
      echo ".kamal/secrets.production"
    fi
  fi
}

# Load KEY=VALUE secrets (macOS ships Bash 3.2 — do NOT use `source <(...)`;
# process substitution + source does not export vars there).
load_secrets() {
  local f line key val
  local files
  files="$(secrets_files)"
  # shellcheck disable=SC2086
  for f in $files; do
    if [[ ! -f "$f" ]]; then
      die "Missing secrets file: $f (see .kamal/secrets.example and .kamal/README.md)"
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
      # strip CR (Windows / some editors)
      line="${line%$'\r'}"
      case "$line" in
        ''|\#*) continue ;;
      esac
      case "$line" in
        *=*) ;;
        *) continue ;;
      esac
      key="${line%%=*}"
      val="${line#*=}"
      # valid env key only
      case "$key" in
        ''|*[!A-Za-z0-9_]*|[0-9]*) continue ;;
      esac
      # export without evaluating value as shell (no source/eval)
      export "${key}=${val}"
    done <"$f"
  done

  if [[ -z "${KAMAL_REGISTRY_USERNAME:-}" ]]; then
    die "KAMAL_REGISTRY_USERNAME missing or empty in secrets (check .kamal/secrets-common)"
  fi
  if [[ -z "${KAMAL_REGISTRY_PASSWORD:-}" ]]; then
    die "KAMAL_REGISTRY_PASSWORD missing or empty in secrets (check .kamal/secrets-common)"
  fi
}

git_is_dirty() {
  # porcelain non-empty = dirty
  [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]
}

# Shipping / identity actions: must start from a clean tree (unless CLI override).
command_requires_clean_tree() {
  case "${COMMAND:-}" in
    wizard|preflight|config|build-push|rollout) return 0 ;;
    *) return 1 ;;
  esac
}

# --allow-dirty only applies to pre-prod (never production).
allow_dirty_effective() {
  [[ "${ALLOW_DIRTY:-0}" -eq 1 && "${ENV_NAME:-}" == "pre-prod" ]]
}

# Hard rule at the beginning — not mid-wizard at the version phase.
assert_clean_working_tree() {
  command_requires_clean_tree || return 0

  # Custom tag override (any env) — still ships working tree as-is
  if [[ -n "${VERSION_OVERRIDE:-}" ]]; then
    return 0
  fi

  # Dirty allowed only for pre-prod
  if allow_dirty_effective; then
    return 0
  fi

  if ! git_is_dirty; then
    return 0
  fi

  echo "" >&2
  echo "ERROR: Git working tree is dirty — stopped at the start (before any phase)." >&2
  echo "  Action '$COMMAND' on '${ENV_NAME}' requires a clean tree so the image tag matches commits." >&2
  echo "" >&2
  echo "  Uncommitted / untracked:" >&2
  git status --porcelain | head -30 >&2
  echo "" >&2
  if [[ "${ENV_NAME:-}" == "production" ]]; then
    if [[ "${ALLOW_DIRTY:-0}" -eq 1 ]]; then
      echo "  Note: --allow-dirty was set but is NOT allowed for production." >&2
    fi
    echo "  Fix: commit (or stash), then re-run:  $0" >&2
    echo "  Production never accepts a dirty working tree." >&2
  else
    echo "  Fix: commit (or stash), then re-run:  $0" >&2
    echo "  Or (pre-prod only) ship uncommitted work:" >&2
    echo "    $0 --allow-dirty" >&2
    echo "    $0 --version TAG" >&2
  fi
  exit 1
}

resolve_version() {
  if [[ -n "$VERSION_OVERRIDE" ]]; then
    export VERSION="$VERSION_OVERRIDE"
    return 0
  fi
  if git_is_dirty; then
    if allow_dirty_effective; then
      export VERSION="$(git rev-parse --short HEAD)-dirty-$(date +%Y%m%d%H%M%S)"
      echo "WARN: dirty tree; using VERSION=$VERSION (--allow-dirty, pre-prod only)"
      return 0
    fi
    # Should have been caught by assert_clean_working_tree; keep as safety net
    die "Git working tree is dirty. Commit first, or (pre-prod only) --allow-dirty / --version TAG"
  fi
  export VERSION="$(git rev-parse HEAD)"
}

absolute_image() {
  echo "${REGISTRY_HOST}/${IMAGE_REPO}:${VERSION}"
}

setup_log() {
  if [[ "$NO_LOG" -eq 1 ]]; then
    LOG_FILE=""
    return 0
  fi
  mkdir -p log/deploy
  LOG_FILE="log/deploy/${ENV_NAME}-$(ts)-${COMMAND}.log"
  {
    echo "# gs-deploy log"
    echo "# started: $(date -Iseconds 2>/dev/null || date)"
    echo "# env=$ENV_NAME command=$COMMAND cwd=$ROOT"
    echo "# argv: $*"
    echo ""
  } >"$LOG_FILE"
  echo "Logging to: $LOG_FILE"
}

# Run kamal inside Docker (no bare-metal Ruby/Kamal on the Mac required).
# Usage: run_kamal <kamal args…>   e.g.  run_kamal build push
#         run_kamal deploy --skip-push
# Streams full stdout/stderr (via run_logged).
#
# Uses ghcr.io/basecamp/kamal (docker CLI + buildx included). The host Docker
# socket is mounted so builds run on Docker Desktop, not inside a nested daemon.
run_kamal() {
  local dest host
  dest="$(kamal_destination)"
  host="$(deploy_host)"

  local ssh_key="${HOME}/.ssh/global-symbols.pem"
  [[ -f "$ssh_key" ]] || die "SSH key not found: $ssh_key"

  local docker_sock="/var/run/docker.sock"
  [[ -S "$docker_sock" ]] || die "Docker socket not found at $docker_sock (is Docker Desktop running?)"

  # Official image expects app at /workdir
  echo "+ docker run ${KAMAL_IMAGE}  →  kamal $* -d ${dest}  (VERSION=${VERSION:-auto})"

  run_logged docker run --rm -i \
    -v "$ROOT":/workdir \
    -v "$ssh_key":/root/.ssh/global-symbols.pem:ro \
    -v "$docker_sock":/var/run/docker.sock \
    -w /workdir \
    -e KAMAL_REGISTRY_USERNAME \
    -e KAMAL_REGISTRY_PASSWORD \
    -e SECRET_KEY_BASE \
    -e GS_DATABASE_PASSWORD \
    -e REDIS_PASSWORD \
    -e DIRECTUS_TOKEN_CMS \
    -e DIRECTUS_WEBHOOK_SECRET \
    -e MYSQL_ROOT_PASSWORD \
    -e MYSQL_PASSWORD \
    -e VERSION \
    -e "GS_KAMAL_DEST=${dest}" \
    -e "GS_DEPLOY_HOST=${host}" \
    --entrypoint sh \
    "$KAMAL_IMAGE" \
    -c '
set -eu
mkdir -p /root/.ssh
chmod 700 /root/.ssh
# Avoid HostKeyMismatch for rollout SSH from this container
ssh-keyscan -H "$GS_DEPLOY_HOST" >> /root/.ssh/known_hosts 2>/dev/null || true
chmod 600 /root/.ssh/known_hosts 2>/dev/null || true
# Sanity: buildx must exist (official image includes it)
docker buildx version >/dev/null
echo "+ kamal $* -d $GS_KAMAL_DEST  (VERSION=${VERSION:-auto})"
exec kamal "$@" -d "$GS_KAMAL_DEST"
' sh "$@"
}

# ─── phases ───────────────────────────────────────────────────────────────

cmd_help() {
  usage 0
}

# True if Docker config already mentions ghcr.io (Desktop keychain / stored auth).
# Not a network check — if push later fails with unauthorized, use --force-login.
ghcr_session_looks_logged_in() {
  local cfg="${DOCKER_CONFIG:-$HOME/.docker}/config.json"
  [[ -f "$cfg" ]] || return 1
  # Match "ghcr.io" as a registry host entry (auths / credHelpers)
  grep -Eq '"ghcr\.io"[[:space:]]*:' "$cfg" 2>/dev/null
}

# Checks + image tag + GHCR login (first wizard step).
cmd_preflight() {
  phase_banner "preflight ($ENV_NAME) — checks + tag + GHCR"
  local ok=1

  echo "— Checks —"
  echo "• repo root: $ROOT"
  if ! command -v docker >/dev/null 2>&1; then
    echo "✗ docker not found on PATH"
    ok=0
  else
    echo "• checking docker CLI (8s timeout)…"
    if ! docker_cli_ok; then
      echo "✗ docker CLI not responding (timed out after 8s)"
      echo "  Docker Desktop is often wedged after a stalled GHCR push."
      echo "  Fix: quit any hung gs-deploy (Ctrl+C), restart Docker Desktop, re-run."
      ok=0
    else
      local dver
      dver="$(run_with_timeout 8 docker version --format '{{.Client.Version}}' 2>/dev/null || echo present)"
      echo "• docker: $dver"
      echo "• checking docker daemon (8s timeout)…"
      if ! docker_daemon_ok; then
        echo "✗ docker daemon not reachable or hung"
        echo "  Restart Docker Desktop, then re-run $0"
        ok=0
      else
        echo "✓ docker daemon OK"
      fi
    fi
  fi

  if ! command -v git >/dev/null 2>&1; then
    echo "✗ git not found"
    ok=0
  else
    echo "• git: $(git rev-parse --short HEAD 2>/dev/null) branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    if git_is_dirty; then
      if allow_dirty_effective || [[ -n "$VERSION_OVERRIDE" ]]; then
        echo "⚠  working tree DIRTY (allowed: pre-prod --allow-dirty and/or --version):"
        git status --porcelain | head -20
      else
        echo "✗ working tree DIRTY (hard rule: commit before shipping;"
        echo "    --allow-dirty is pre-prod only, never production):"
        git status --porcelain | head -20
        ok=0
      fi
    else
      echo "✓ working tree clean"
    fi
  fi

  local f
  for f in $(secrets_files); do
    if [[ -f "$f" ]]; then
      echo "✓ secrets: $f"
    else
      echo "✗ missing: $f"
      ok=0
    fi
  done

  local ssh_key="${HOME}/.ssh/global-symbols.pem"
  if [[ -f "$ssh_key" ]]; then
    echo "✓ SSH key: $ssh_key"
  else
    echo "✗ SSH key missing: $ssh_key"
    ok=0
  fi

  for f in config/deploy.yml "config/deploy.${ENV_NAME}.yml" Dockerfile; do
    if [[ -f "$f" ]]; then
      echo "✓ $f"
    else
      echo "✗ missing $f"
      ok=0
    fi
  done

  local host
  host="$(deploy_host)"
  echo "• target host: $host"
  if [[ "$ENV_NAME" == "production" && "$host" == REPLACE* ]]; then
    echo "✗ production host still a placeholder in config/deploy.production.yml"
    ok=0
  fi

  if [[ "$ok" -ne 1 ]]; then
    phase_fail "preflight" 1
    return 1
  fi

  echo ""
  echo "— Image tag —"
  resolve_version
  echo "VERSION=$VERSION"
  echo "absolute image: $(absolute_image)"
  if git_is_dirty; then
    echo "note: tree is dirty (override or --allow-dirty in effect)"
  fi

  echo ""
  echo "— GHCR login —"
  if [[ "$SKIP_LOGIN" -eq 1 ]]; then
    echo "Skipping docker login (--skip-login)."
  elif [[ "$FORCE_LOGIN" -ne 1 ]] && ghcr_session_looks_logged_in; then
    echo "Docker already has credentials for ${REGISTRY_HOST} — skipping login."
    echo "  If a later push fails with unauthorized: re-run with --force-login"
  else
    if [[ "$FORCE_LOGIN" -eq 1 ]]; then
      echo "Forcing docker login (--force-login)…"
    fi
    load_secrets
    echo "Logging in to ${REGISTRY_HOST} as ${KAMAL_REGISTRY_USERNAME} …"
    set +e
    run_logged bash -c 'echo "$KAMAL_REGISTRY_PASSWORD" | docker login "'"$REGISTRY_HOST"'" -u "$KAMAL_REGISTRY_USERNAME" --password-stdin'
    local rc=$?
    set -e
    if [[ "$rc" -ne 0 ]]; then
      phase_fail "preflight" "$rc"
      return "$rc"
    fi
  fi

  phase_ok "preflight"
}

cmd_config() {
  phase_banner "config (kamal config -d $(kamal_destination); read-only)"
  load_secrets
  resolve_version
  echo "Resolved VERSION=$VERSION"
  echo "Running kamal config (full output follows)…"
  set +e
  run_kamal config
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    phase_fail "config" "$rc"
    return "$rc"
  fi
  phase_ok "config"
}

# True if Docker has a local image for the absolute tag (rare with buildx --push).
local_image_present() {
  docker image inspect "$(absolute_image)" >/dev/null 2>&1
}

# (1) Mac only: build image + push to GHCR — does not change the server.
# GHCR often stalls mid-push; we retry. Already-uploaded layers are skipped on retry.
cmd_build_push() {
  phase_banner "build-push (Mac → GHCR; no server change)"
  load_secrets
  resolve_version
  local img
  img="$(absolute_image)"
  # Validate retry count (Bash 3.2–safe)
  case "$PUSH_MAX_ATTEMPTS" in
    ''|*[!0-9]*|0) PUSH_MAX_ATTEMPTS=8 ;;
  esac
  case "$PUSH_RETRY_SLEEP" in
    ''|*[!0-9]*) PUSH_RETRY_SLEEP=20 ;;
  esac
  case "$PUSH_STALL_SECONDS" in
    ''|*[!0-9]*|0) PUSH_STALL_SECONDS=180 ;;
  esac

  echo "Destination config: $(kamal_destination)  (used for image name / arch only)"
  echo "Image:              $img"
  echo "Push retries:       up to ${PUSH_MAX_ATTEMPTS} attempts (sleep ${PUSH_RETRY_SLEEP}s+, backoff +10s)"
  echo "Hang watchdog:      kill attempt if no new output for ${PUSH_STALL_SECONDS}s, then retry"
  echo "What this does:"
  echo "  • Build Dockerfile on this Mac (Docker Desktop, arm64)"
  echo "  • Push image to ${REGISTRY_HOST}"
  echo "  • On fail OR silent hang: retry (uploaded layers stay on GHCR; rebuild uses cache)"
  echo "  • Does NOT SSH / restart containers on $(deploy_host)"
  confirm_build_push

  local attempt=1
  local rc=1
  local sleep_s="$PUSH_RETRY_SLEEP"

  while [[ "$attempt" -le "$PUSH_MAX_ATTEMPTS" ]]; do
    echo ""
    banner "build-push attempt ${attempt}/${PUSH_MAX_ATTEMPTS}"
    echo "Image: $img"
    echo "Watchdog: ${PUSH_STALL_SECONDS}s without new output → kill & retry"
    echo "Full command output below (not filtered)…"

    set +e
    if [[ "$attempt" -gt 1 ]] && local_image_present; then
      echo "Local image found — docker push only (no rebuild)…"
      run_with_stall_watch "$PUSH_STALL_SECONDS" docker push "$img"
      rc=$?
    else
      if [[ "$attempt" -gt 1 ]]; then
        echo "Retrying kamal build push (BuildKit cache + partial GHCR layers)…"
      else
        echo "Starting kamal build push…"
      fi
      run_with_stall_watch "$PUSH_STALL_SECONDS" run_kamal build push
      rc=$?
    fi
    set -e

    if [[ "$rc" -eq 0 ]]; then
      phase_ok "build-push"
      echo ""
      echo "Image is in GHCR after attempt ${attempt}/${PUSH_MAX_ATTEMPTS}."
      echo "Next: rollout (pull + restart on the server)."
      return 0
    fi

    echo ""
    if [[ "$rc" -eq "$STALL_EXIT_CODE" ]]; then
      echo "WARN: build-push attempt ${attempt}/${PUSH_MAX_ATTEMPTS} hung (no output ${PUSH_STALL_SECONDS}s) — will retry."
    else
      echo "WARN: build-push attempt ${attempt}/${PUSH_MAX_ATTEMPTS} failed (exit ${rc})."
    fi
    if [[ "$attempt" -ge "$PUSH_MAX_ATTEMPTS" ]]; then
      break
    fi
    echo "  Waiting ${sleep_s}s then retrying (layers already on GHCR are skipped)…"
    echo "  Tip: max-concurrent-uploads=1 should already be set in ~/.docker/daemon.json"
    sleep "$sleep_s"
    sleep_s=$((sleep_s + 10))
    attempt=$((attempt + 1))
  done

  phase_fail "build-push" "$rc"
  echo "  All ${PUSH_MAX_ATTEMPTS} attempts failed. Re-run: $0  (menu → build-push)" >&2
  echo "  Or: $0 --push-retries 12 --push-stall 120" >&2
  return "$rc"
}

# (2) Server: pull image already in GHCR + restart web/job.
cmd_rollout() {
  phase_banner "rollout (server $(deploy_host); TOUCHES SERVER)"
  load_secrets
  resolve_version
  echo "Destination: $(kamal_destination)"
  echo "Host:        $(deploy_host)"
  echo "Image:       $(absolute_image)"
  echo "What this does:"
  echo "  • kamal deploy --skip-push  (no rebuild on the Mac)"
  echo "  • SSH to host, pull image, replace web + job, healthcheck proxy"
  confirm_rollout
  echo "Starting kamal deploy --skip-push — full stream below (not filtered)…"
  set +e
  run_kamal deploy --skip-push
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    phase_fail "rollout" "$rc"
    return "$rc"
  fi
  phase_ok "rollout"
  echo ""
  echo "Next: smoke check, then verify on the server (hint-verify)."
}

cmd_smoke() {
  phase_banner "smoke (HTTP check; does not change server)"
  local host header
  host="$(deploy_host)"
  header="$(http_host_header)"
  if [[ "$host" == REPLACE* ]]; then
    die "Cannot smoke: host is still a placeholder ($host)"
  fi
  echo "curl -sS -D- -o /dev/null -H \"Host: ${header}\" \"http://${host}/\""
  set +e
  run_logged curl -sS -D- -o /dev/null --max-time 30 -H "Host: ${header}" "http://${host}/"
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    phase_fail "smoke" "$rc"
    return "$rc"
  fi
  phase_ok "smoke"
}

cmd_hint_verify() {
  phase_banner "hint-verify (instructions only — suite runs ON the server)"
  local host web_filter profile
  host="$(deploy_host)"
  if [[ "$ENV_NAME" == "pre-prod" ]]; then
    web_filter="gs-repo-web-pre-prod"
    profile="pre_prod"
  else
    web_filter="gs-repo-web-production"
    profile="prod"
  fi
  cat <<EOF
Deploy verify ships IN the app image and must run on the app host
(IP allowlist + RuntimeGuard). Not from this laptop as the primary path.

1) SSH:
   ssh -i ~/.ssh/global-symbols.pem ubuntu@${host}

2) Inside the server:
   WEB=\$(docker ps -q -f name=${web_filter} | head -1)
   docker exec "\$WEB" /rails/deploy_verify/bin/run ${profile}

   # or host wrapper (if present on server):
   # script/run_deploy_verify.sh ${profile}

Reports: container /tmp/deploy_verify/ (host script may copy to host /tmp/deploy_verify/)
EOF
  phase_ok "hint-verify"
}

cmd_wizard() {
  banner "Global Symbols deploy wizard → ${ENV_NAME}"
  echo "Host: $(deploy_host)"
  echo "Each phase streams full command output. Logs: log/deploy/ (unless --no-log)."
  echo "Quit anytime with q at a pause prompt. Re-run a single phase if one fails."
  echo ""

  local phases=(preflight config build-push rollout smoke hint-verify)
  local p
  for p in "${phases[@]}"; do
    case "$p" in
      preflight)
        cmd_preflight || return $?
        pause_wizard "config (read-only kamal)"
        ;;
      config)
        cmd_config || return $?
        pause_wizard "build-push (Mac → GHCR, no server change)"
        ;;
      build-push)
        cmd_build_push || return $?
        pause_wizard "rollout (TOUCHES SERVER)"
        ;;
      rollout)
        cmd_rollout || return $?
        pause_wizard "smoke"
        ;;
      smoke)
        # smoke failure should not hide success of rollout; warn but continue
        set +e
        cmd_smoke
        local src=$?
        set -e
        if [[ "$src" -ne 0 ]]; then
          echo "WARN: smoke failed (exit $src). Rollout may still have succeeded — investigate."
          if [[ "$YES" -eq 0 ]]; then
            pause_wizard "hint-verify (despite smoke failure)"
          fi
        else
          pause_wizard "hint-verify"
        fi
        ;;
      hint-verify)
        cmd_hint_verify || return $?
        ;;
    esac
  done

  banner "Wizard finished for ${ENV_NAME}"
  if [[ -n "${LOG_FILE:-}" ]]; then
    echo "Full log: $LOG_FILE"
  fi
}

# ─── main ─────────────────────────────────────────────────────────────────

main() {
  parse_args "$@"
  if [[ "$COMMAND" == "help" ]]; then
    cmd_help
  fi

  # Hard rule first (CLI path; menu also asserts right after action pick)
  assert_clean_working_tree

  setup_log "$0" "$@"
  banner "gs-deploy  env=${ENV_NAME}  command=${COMMAND}"
  echo "Repo: $ROOT"
  if [[ -n "${LOG_FILE:-}" ]]; then
    echo "Log:  $LOG_FILE"
  fi

  case "$COMMAND" in
    wizard)      cmd_wizard ;;
    preflight)   cmd_preflight ;;
    config)      cmd_config ;;
    build-push)  cmd_build_push ;;
    rollout)     cmd_rollout ;;
    smoke)       cmd_smoke ;;
    hint-verify) cmd_hint_verify ;;
    *) die "internal: unhandled command $COMMAND" ;;
  esac
}

main "$@"
